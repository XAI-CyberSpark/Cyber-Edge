{
  "name": "oakegde-studio-desktop",
  "version": "2.8.0",
  "private": true,
  "description": "OAKEgde Studio Desktop Shell",
  "main": "main.cjs",
  "scripts": {
    "build:studio": "npm --prefix ../studio run build:desktop",
    "prepare:assets": "node ./scripts/prepare-resources.mjs",
    "build": "npm run build:studio && npm run prepare:assets",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist:linux": "npm run build && electron-builder --linux AppImage dir"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.oakegde.studio.desktop",
    "productName": "OAKEgde Studio Desktop",
    "files": [
      "main.cjs",
      "preload.cjs",
      "app-loading.html",
      "app/**/*"
    ],
    "extraResources": [
      {
        "from": "runtime/backend",
        "to": "backend"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ],
      "category": "Development"
    }
  }
}
